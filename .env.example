# Application
APP_NAME=RAG Engine
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (PostgreSQL with pgvector)
# Local: postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db
# Neon: postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/rag_db?sslmode=require
DATABASE_URL=

# Redis (Upstash or local)
# Local: redis://localhost:6379/0
# Upstash: rediss://:token@host:port/0
REDIS_URL=redis://localhost:6379/0

# Vector Database - Pinecone (Primary)
# Get from https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-documents
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine

# Vector Database - Qdrant (Local dev fallback)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_documents

# Embeddings - Voyage AI (Primary)
# Get from https://www.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_BATCH_SIZE=128

# LLM - Groq (Primary, streaming)
# Get from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# LLM - Gemini (Fallback, streaming)
# Get from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Auth - Clerk
# Get from https://clerk.com/
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Auth - Simple credentials (login page)
AUTH_USERNAME=dev-user
AUTH_PASSWORD=
AUTH_SECRET=

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Search
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60